{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://di.local/schemas/observation.schema.json",
  "title": "DI observation file",
  "description": "One file per reference and authorship (verified.json = deterministic normalizer; analyst.json = OBSERVED/INFERRED). See docs/EVIDENCE-TAXONOMY.md.",
  "type": "object",
  "required": ["ref_id", "authorship", "generated_at", "observations"],
  "additionalProperties": false,
  "properties": {
    "ref_id": { "type": "string", "pattern": "^(ref|val|hol)-[0-9]{3}$" },
    "authorship": { "enum": ["normalizer", "analyst"] },
    "generator": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } }
  },
  "$defs": {
    "evidencePointer": {
      "oneOf": [
        {
          "type": "object",
          "required": ["path", "pointer"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "pattern": "^datasets/raw/" },
            "pointer": { "type": "string", "pattern": "^(/[^/]*)*$", "description": "RFC 6901 JSON pointer into the raw file." }
          }
        },
        {
          "type": "object",
          "required": ["artifact", "sha256"],
          "additionalProperties": false,
          "properties": {
            "artifact": { "type": "string", "description": "research-artifacts/<ref>/<capture>/<file>" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "region": { "type": "string", "description": "Optional human description of the region inspected." }
          }
        },
        {
          "type": "object",
          "required": ["observation"],
          "additionalProperties": false,
          "properties": {
            "observation": { "type": "string", "description": "ID of another observation this one is based on." }
          }
        },
        {
          "type": "object",
          "required": ["source_id"],
          "additionalProperties": false,
          "properties": {
            "source_id": { "type": "string", "description": "ID in provenance/sources.yaml (external documentation)." },
            "locator": { "type": "string" }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "required": ["id", "ref_id", "page", "capture_id", "viewport", "category", "property", "value", "evidence_type", "method", "evidence", "confidence", "assessment"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(ref|val|hol)-[0-9]{3}\\.[a-z-]+\\.[a-z0-9.-]+$" },
        "ref_id": { "type": "string", "pattern": "^(ref|val|hol)-[0-9]{3}$" },
        "page": { "type": "string" },
        "source_url": { "type": "string" },
        "capture_id": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" },
        "viewport": { "type": "string", "pattern": "^([0-9]{3,4}x[0-9]{3,4}|cross-viewport)$" },
        "category": { "enum": ["typography", "layout", "spacing", "color", "hierarchy", "components", "motion", "responsive", "accessibility", "performance", "assets", "implementation", "rtl", "content", "context"] },
        "property": { "type": "string", "minLength": 1 },
        "value": {},
        "unit": { "type": "string" },
        "evidence_type": { "enum": ["VERIFIED", "OBSERVED", "INFERRED"] },
        "method": { "enum": ["computed-style", "layout-measurement", "dom", "cssom", "network", "performance-api", "accessibility-tree", "axe", "lighthouse", "web-animations-api", "instrumentation", "external-documentation", "screenshot", "frame-sequence", "interaction", "analyst-judgment"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidencePointer" } },
        "statement": { "type": "string" },
        "interpretation": {
          "type": "object",
          "required": ["claim", "confidence"],
          "additionalProperties": false,
          "properties": {
            "claim": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 0.95 }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "assessment": { "enum": ["strength", "weakness", "trade-off", "neutral"] },
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
      },
      "allOf": [
        {
          "if": { "properties": { "evidence_type": { "const": "VERIFIED" } } },
          "then": {
            "properties": {
              "method": { "enum": ["computed-style", "layout-measurement", "dom", "cssom", "network", "performance-api", "accessibility-tree", "axe", "lighthouse", "web-animations-api", "instrumentation", "external-documentation"] },
              "confidence": { "minimum": 0.9 }
            }
          }
        },
        {
          "if": { "properties": { "evidence_type": { "const": "OBSERVED" } } },
          "then": {
            "required": ["statement"],
            "properties": {
              "method": { "enum": ["screenshot", "frame-sequence", "interaction"] },
              "evidence": { "contains": { "required": ["artifact"] } }
            }
          }
        },
        {
          "if": { "properties": { "evidence_type": { "const": "INFERRED" } } },
          "then": {
            "required": ["statement"],
            "properties": {
              "method": { "const": "analyst-judgment" },
              "confidence": { "maximum": 0.95 },
              "evidence": { "contains": { "required": ["observation"] } }
            }
          }
        }
      ]
    }
  }
}
