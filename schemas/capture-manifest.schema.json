{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://di.local/schemas/capture-manifest.schema.json",
  "title": "DI raw capture manifest",
  "type": "object",
  "required": ["capture_id", "ref_id", "page_id", "url", "started_at", "tool", "robots", "consent", "blocked", "viewports", "files", "artifacts", "errors"],
  "additionalProperties": false,
  "properties": {
    "capture_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$" },
    "ref_id": { "type": "string", "pattern": "^(ref|val|hol|bench)-[0-9a-z-]+$" },
    "page_id": { "type": "string" },
    "url": { "type": "string" },
    "final_url": { "type": ["string", "null"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "tool": {
      "type": "object",
      "required": ["name", "version", "playwright", "browser"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "playwright": { "type": "string" },
        "browser": { "type": "string" },
        "axe": { "type": "string" }
      }
    },
    "environment": { "type": "object" },
    "robots": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["allowed", "disallowed", "absent", "unknown", "not-applicable"] },
        "checked_url": { "type": ["string", "null"] },
        "matched_rule": { "type": ["string", "null"] }
      }
    },
    "consent": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "enum": ["rejected-nonessential", "closed", "none-found", "left-as-is", "not-applicable"] },
        "detail": { "type": "string" }
      }
    },
    "blocked": { "type": "boolean" },
    "blocked_reason": { "type": ["string", "null"] },
    "viewports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "width", "height", "status"],
        "properties": {
          "name": { "type": "string" },
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "status": { "enum": ["ok", "error", "blocked", "skipped"] },
          "http_status": { "type": ["integer", "null"] },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Files kept out of Git (research-artifacts/). Hash-linked.",
      "items": {
        "type": "object",
        "required": ["file", "sha256", "bytes", "kind"],
        "properties": {
          "file": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer" },
          "kind": { "enum": ["screenshot", "frame", "aria-snapshot", "axe-full", "lighthouse-report", "video", "other"] },
          "viewport": { "type": ["string", "null"] },
          "state": { "type": ["string", "null"] }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}
