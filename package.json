    "corpus:check": "node scripts/check-corpus.ts",
    "collect": "node scripts/collect.ts",
    "normalize": "node scripts/normalize.ts",
    "lighthouse": "node scripts/lighthouse.ts",
    "skill:build": "node scripts/build-skill.ts",
    "skill:package": "node scripts/package-skill.ts",
    "why": "node scripts/why.ts",
    "bench:score": "node scripts/score-benchmark.ts",
    "test:browser": "node --test tests/browser/*.test.ts",
    "validation:check": "node scripts/validation-check.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "ajv": "8.20.0",
