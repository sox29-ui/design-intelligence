    "axe-core": "4.13.0",
    "lighthouse": "13.5.0",
    "playwright": "1.56.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
